# Copy to .env and adjust. Variables set in the shell take precedence over this file.

# Port of the viewer (http://HOST:PORT)
PORT=3000
# 127.0.0.1 = this computer only; 0.0.0.0 = reachable from the local network (e.g. a phone)
HOST=127.0.0.1
# Folder with <doll>/doll.json; default: ../assets next to this server
# ASSETS_DIR=../assets
